<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReLive Compressor" Width="1300" Height="800" MinWidth="1200" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#101010" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#E5202E"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF3B48"/>
    <SolidColorBrush x:Key="Muted" Color="#8E8E8E"/>
    <SolidColorBrush x:Key="CardBg" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="CardHead" Color="#151515"/>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <!-- check box (also three-state for "part of this game selected") -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EDEDED"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="2" BorderBrush="#7A7A7A" BorderThickness="1.5" Background="#151515" VerticalAlignment="Center">
                <Grid>
                  <TextBlock x:Name="tick" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                  <Border x:Name="part" Width="8" Height="2" Background="White" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#BDBDBD"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="part" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- expand / collapse arrow for a game on the Compress page -->
    <Style x:Key="Chevron" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Width="24" Height="24">
              <TextBlock x:Name="g" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="10" Foreground="#A8A8A8"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="g" Property="Text" Value="&#xE70D;"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small icon button inside list rows (play, compare, open folder) -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#A8A8A8"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="2" Width="26" Height="24">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#333333"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- top navigation tabs -->
    <Style x:Key="NavTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#9A9A9A"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Margin" Value="0,0,30,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
              <Border x:Name="u" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,9" Background="{StaticResource Accent}" Visibility="Hidden"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter TargetName="u" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- on/off switch -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="#454545">
              <Ellipse x:Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- buttons -->
    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="22,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnDark" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
      <Setter Property="Background" Value="#2C2C2C"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A3A3A"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnDark}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,5"/>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
      <Setter Property="Background" Value="#5A1218"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="#BDBDBD"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="White"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WinClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- big icon tile, like the capture tiles -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Background" Value="#1C1C1C"/>
      <Setter Property="Foreground" Value="#D6D6D6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="#121212" BorderThickness="0,0,1,1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#262626"/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- cards -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Margin" Value="7"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardHead}"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="3,3,0,0"/>
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Light"/>
    </Style>

    <!-- settings rows -->
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Background" Value="#1D1D1D"/>
      <Setter Property="BorderBrush" Value="#131313"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="MinHeight" Value="46"/>
    </Style>
    <Style x:Key="RowValue" TargetType="Border">
      <Setter Property="Background" Value="#191919"/>
      <Setter Property="Padding" Value="14,0"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style x:Key="RowState" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#C8C8C8"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="4,22,0,12"/>
    </Style>

    <!-- dark combo box -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
      <Border Background="Transparent">
        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Data="M0,0 L5,5 L10,0" Stroke="#BBBBBB" StrokeThickness="1.4"/>
      </Border>
    </ControlTemplate>
    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#C8C8C8"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="0,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" Margin="-14,0,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <StackPanel IsItemsHost="True"/>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#D0D0D0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="14,8"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#2E2E2E" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="#3A3A3A" CornerRadius="4"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C8C8C8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- round "i" button that opens an explanation -->
    <Style x:Key="InfoBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="How does this work?"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="17" Height="17" CornerRadius="9" BorderBrush="#808080" BorderThickness="1.3" Background="Transparent">
              <TextBlock x:Name="t" Text="i" FontFamily="Georgia" FontSize="11" FontWeight="Bold" Foreground="#A8A8A8"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="t" Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- big selectable box (what happens to original recordings) -->
    <Style x:Key="ModeTile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EDEDED"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="#1D1D1D" BorderBrush="#2E2E2E" BorderThickness="2" CornerRadius="3" Padding="14,14,14,12">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#242424"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="#2A1517"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- radio button for dialogs -->
    <Style x:Key="DarkRadio" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EDEDED"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="#888888" StrokeThickness="1.5" Fill="#151515"/>
                <Ellipse x:Name="dot" Width="7" Height="7" Fill="White" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Fill" Value="{StaticResource Accent}"/>
                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slider: red filled part, white knob; click anywhere on the track to jump there -->
    <Style x:Key="DarkSlider" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="22" VerticalAlignment="Center" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#3A3A3A" VerticalAlignment="Center" Margin="8,0"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" Margin="8,0,0,0"/></Border></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="16" Height="16" Fill="White"/></ControlTemplate></Thumb.Template></Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- whole list row as a button (click to play the video) -->
    <Style x:Key="RowBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EDEDED"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262626"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="#101010">
    <DockPanel>
      <!-- ======== top bar ======== -->
      <Border DockPanel.Dock="Top" Background="#1A1A1A" Height="58">
        <Grid>
          <Grid MaxWidth="1340" Margin="24,0"><StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" Background="{StaticResource Accent}" Margin="0,0,24,0">
              <Viewbox Width="40" Height="40">
                <Canvas Width="24" Height="24">
                  <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M1,1 L6.2,6.2 M6.2,2.6 L6.2,6.2 L2.6,6.2 M23,23 L17.8,17.8 M17.8,21.4 L17.8,17.8 L21.4,17.8"/>
                  <Ellipse Canvas.Left="6.1" Canvas.Top="6.1" Width="11.8" Height="11.8" Stroke="White" StrokeThickness="1.6"/>
                  <Path Fill="White" Data="M9.9,8.4 L9.9,15.6 L16,12 Z"/>
                </Canvas>
              </Viewbox>
            </Border>
            <RadioButton x:Name="NavHome" Style="{StaticResource NavTab}" Content="Home" IsChecked="True"/>
            <RadioButton x:Name="NavCompress" Style="{StaticResource NavTab}" Content="Compress"/>
            <RadioButton x:Name="NavActivity" Style="{StaticResource NavTab}" Content="Activity"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}" Content="Settings"/>
          </StackPanel></Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Border x:Name="StatusPill" Background="#262626" CornerRadius="12" Height="26" Padding="12,0" Margin="0,16,18,0" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#7A7A7A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusPillText" Text="Idle" FontSize="12" VerticalAlignment="Center" Foreground="#CFCFCF"/>
              </StackPanel>
            </Border>
            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="&#xE921;"/>
            <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Content="&#xE922;"/>
            <Button x:Name="BtnClose" Style="{StaticResource WinClose}" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid>
        <!-- ======== HOME ======== -->
        <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="17,16" MaxWidth="1354">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- left column -->
            <StackPanel Grid.Column="0">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Border Style="{StaticResource CardTitle}">
                    <DockPanel><Button x:Name="InfoAuto" DockPanel.Dock="Right" Style="{StaticResource InfoBtn}"/>
                      <TextBlock Style="{StaticResource CardTitleText}" Text="AUTOMATIC COMPRESSION"/></DockPanel>
                  </Border>
                  <Grid Margin="16,18,16,6">
                    <TextBlock x:Name="AutoBig" Style="{StaticResource Big}" Text="Off"/>
                    <ToggleButton x:Name="AutoToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                  </Grid>
                  <TextBlock x:Name="AutoText" Margin="16,0,16,18" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"
                             Text="Runs after 10 idle minutes and pauses as soon as you're back."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Border Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource CardTitleText}" Text="STORAGE"/></Border>
                  <StackPanel Margin="16,14,16,18">
                    <TextBlock Style="{StaticResource Label}" Text="Recordings folder"/>
                    <TextBlock x:Name="StTotal" Style="{StaticResource Big}" Text="-"/>
                    <TextBlock x:Name="StTotalSub" Style="{StaticResource Label}" Text=""/>
                    <ProgressBar x:Name="StBar" Margin="0,12,0,4" Maximum="100" Value="0"/>
                    <TextBlock x:Name="StBarText" Style="{StaticResource Label}" Text=""/>
                    <Grid Margin="0,16,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Saved so far"/>
                        <TextBlock x:Name="StSaved" FontSize="18" Text="-"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Label}" Text="Waiting"/>
                        <TextBlock x:Name="StWaiting" FontSize="18" Text="-"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- middle column -->
            <StackPanel Grid.Column="1">
              <Border x:Name="UpdBanner" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,0">
                <Border BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0" Padding="16,12">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="UpdLater" Style="{StaticResource BtnSmall}" Content="Later" Margin="0,0,8,0"/>
                      <Button x:Name="UpdNow" Style="{StaticResource BtnPrimary}" Content="Update now"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="15" Foreground="{StaticResource Accent}" Margin="0,1,10,0"/>
                        <TextBlock x:Name="UpdTitle" FontSize="14" FontWeight="SemiBold" Text="Update available"/>
                      </StackPanel>
                      <TextBlock x:Name="UpdNotes" Margin="25,4,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Border>
              <Border x:Name="AwayCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Border BorderBrush="#3FB950" BorderThickness="3,0,0,0" Padding="16,12">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="AwaySee" Style="{StaticResource BtnSmall}" Content="See what changed" Margin="0,0,8,0"/>
                      <Button x:Name="AwayClose" Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="Dismiss"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="15" Foreground="#3FB950" Margin="0,1,10,0"/>
                      <TextBlock x:Name="AwayText" FontSize="14" Text=""/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Border Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource CardTitleText}" Text="NOW"/></Border>
                  <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="256" Height="144" Background="#141414" CornerRadius="2" ClipToBounds="True">
                      <Grid>
                        <Viewbox Width="48" Height="48" Opacity="0.25">
                          <Canvas Width="24" Height="24">
                            <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M1,1 L6.2,6.2 M6.2,2.6 L6.2,6.2 L2.6,6.2 M23,23 L17.8,17.8 M17.8,21.4 L17.8,17.8 L21.4,17.8"/>
                            <Ellipse Canvas.Left="6.1" Canvas.Top="6.1" Width="11.8" Height="11.8" Stroke="White" StrokeThickness="1.6"/>
                            <Path Fill="White" Data="M9.9,8.4 L9.9,15.6 L16,12 Z"/>
                          </Canvas>
                        </Viewbox>
                        <Image x:Name="NowThumb" Stretch="UniformToFill"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,2,0,0">
                      <TextBlock x:Name="NowGame" Style="{StaticResource Label}" Text=""/>
                      <TextBlock x:Name="NowTitle" FontSize="20" FontWeight="Light" TextTrimming="CharacterEllipsis" Text="Idle"/>
                      <TextBlock x:Name="NowSub" Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text=""/>
                      <TextBlock x:Name="NowFree" Margin="0,8,0,0" FontSize="15" Foreground="#3FB950" Visibility="Collapsed"/>
                      <ProgressBar x:Name="NowBar" Margin="0,16,0,6" Maximum="100" Value="0"/>
                      <Grid>
                        <TextBlock x:Name="NowPct" Style="{StaticResource Label}" Text=""/>
                        <TextBlock x:Name="NowCount" Style="{StaticResource Label}" HorizontalAlignment="Right" Text=""/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnRun" Style="{StaticResource BtnPrimary}" Content="Compress all waiting" Margin="0,0,10,0"
                                ToolTip="Starts right away with every waiting recording - no need to wait until you're away"/>
                        <Button x:Name="BtnChoose" Style="{StaticResource BtnDark}" Content="Choose videos..." Margin="0,0,10,0"
                                ToolTip="Pick exactly which recordings to compress"/>
                        <Button x:Name="BtnPause" Style="{StaticResource BtnDark}" Content="Pause"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Border Style="{StaticResource CardTitle}">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center" Text="Click to play, or compare before / after"/>
                      <TextBlock Style="{StaticResource CardTitleText}" Text="RECENTLY COMPRESSED"/></DockPanel>
                  </Border>
                  <TextBlock x:Name="RecentEmpty" Margin="16,16" Foreground="{StaticResource Muted}" Text="Nothing compressed yet."/>
                  <ItemsControl x:Name="RecentList" Margin="0,4,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource RowBtn}" Tag="{Binding Path}" ToolTip="{Binding Path}">
                          <Grid Margin="16,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="50"/><ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Game}" Foreground="#8E8E8E" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding File}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="3" Foreground="#B0B0B0"><Run Text="{Binding Before, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding After, Mode=OneWay}"/></TextBlock>
                            <TextBlock Grid.Column="4" Text="{Binding Saved}" Foreground="#3FB950" HorizontalAlignment="Right"/>
                            <Button Grid.Column="5" Style="{StaticResource IconBtn}" Content="&#xE890;" Tag="{Binding CompareTag}" ToolTip="Compare before / after"
                                    HorizontalAlignment="Right" Margin="0,-4" Visibility="{Binding HasCompare, Converter={StaticResource Vis}}"/>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- right column -->
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Border Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource CardTitleText}" Text="ENCODER"/></Border>
                  <Grid Margin="16,14,16,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="GPU" Margin="0,4"/>
                    <TextBlock x:Name="EncGpu" Grid.Column="1" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Codec" Margin="0,4"/>
                    <TextBlock x:Name="EncCodec" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Video bitrate" Margin="0,4"/>
                    <TextBlock x:Name="EncRate" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Preset" Margin="0,4"/>
                    <TextBlock x:Name="EncPreset" Grid.Row="3" Grid.Column="1" Text="-" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Originals" Margin="0,4"/>
                    <TextBlock x:Name="EncMode" Grid.Row="4" Grid.Column="1" Text="-" Margin="0,4" TextWrapping="Wrap"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Border Style="{StaticResource CardTitle}"><TextBlock Style="{StaticResource CardTitleText}" Text="QUICK ACTIONS"/></Border>
                  <UniformGrid Columns="2" Height="230">
                    <Button x:Name="QOpenRec" Style="{StaticResource Tile}">
                      <StackPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Recordings" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="QRescan" Style="{StaticResource Tile}">
                      <StackPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rescan" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="QLog" Style="{StaticResource Tile}">
                      <StackPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Activity" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="QSettings" Style="{StaticResource Tile}">
                      <StackPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Settings" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- ======== COMPRESS ======== -->
        <DockPanel x:Name="PageCompress" Visibility="Collapsed" Margin="24,0" MaxWidth="1340">
          <Grid DockPanel.Dock="Top" Margin="0,22,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontSize="15" Text="Compress" VerticalAlignment="Center"/>
              <TextBlock x:Name="CmpSummary" Foreground="{StaticResource Muted}" FontSize="12" Margin="16,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                         Text="Tip: you can also drop videos here, or right-click them in File Explorer"/>
              <Button x:Name="CmpAll" Style="{StaticResource BtnSmall}" Content="Select all waiting" Margin="0,0,8,0"/>
              <Button x:Name="CmpNone" Style="{StaticResource BtnSmall}" Content="Select none"/>
            </StackPanel>
          </Grid>

          <!-- bottom bar: what's selected, where originals go, start / stop -->
          <Border DockPanel.Dock="Bottom" Background="#1A1A1A" Padding="20,14" Margin="0,10,0,16" CornerRadius="3">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock x:Name="CmpSel" FontSize="16" Text="Nothing selected"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                  <TextBlock x:Name="CmpMode" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                  <Button x:Name="CmpModeChange" Style="{StaticResource BtnSmall}" Content="Change" Padding="10,2" Margin="10,0,0,0" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="CmpLive" FontSize="12" Foreground="#3FB950" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <ProgressBar x:Name="CmpBar" Height="4" Margin="0,6,0,0" Maximum="100" Visibility="Collapsed"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="CmpPause" Style="{StaticResource BtnDark}" Content="Pause" Margin="0,0,10,0" Visibility="Collapsed"/>
                  <Button x:Name="CmpStop" Style="{StaticResource BtnDark}" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Stop"/></StackPanel>
                  </Button>
                  <Button x:Name="CmpStart" Style="{StaticResource BtnPrimary}" FontSize="16" Padding="28,11">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="CmpStartGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <TextBlock x:Name="CmpStartText" Text="Start compressing"/></StackPanel>
                  </Button>
                </StackPanel>
                <TextBlock x:Name="CmpNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Right"
                           Text="Runs right now, even while you use the PC. Pause or stop anytime."/>
              </StackPanel>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Top" Background="#151515" Height="34">
            <Grid Margin="14,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="200"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="2" Style="{StaticResource CardTitleText}" Text="RECORDING"/>
              <TextBlock Grid.Column="3" Style="{StaticResource CardTitleText}" Text="RECORDED"/>
              <TextBlock Grid.Column="4" Style="{StaticResource CardTitleText}" Text="SIZE"/>
              <TextBlock Grid.Column="5" Style="{StaticResource CardTitleText}" Text="STATUS"/>
            </Grid>
          </Border>
          <Border Background="#1C1C1C">
            <Grid>
              <TextBlock x:Name="CmpEmpty" Margin="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="No recordings found yet. Check the recordings folder in Settings, or drop videos here."/>
              <ScrollViewer x:Name="CmpScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CmpList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <Border Background="#222222" BorderBrush="#151515" BorderThickness="0,0,0,1" Padding="14,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource DarkCheck}" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsEnabled="{Binding HasSelectable}" ToolTip="Select every waiting recording of this game"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Chevron}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Left"/>
                            <Border Grid.Column="2" Width="56" Height="32" Background="#151515" CornerRadius="2" ClipToBounds="True" HorizontalAlignment="Left">
                              <Grid>
                                <TextBlock Text="{Binding Initial}" FontSize="15" Foreground="#4A4A4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                              </Grid>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,12,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding Counts}" Foreground="#9A9A9A" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="5" Style="{StaticResource IconBtn}" Content="&#xE8B7;" Tag="{Binding FolderTag}" ToolTip="Open folder" HorizontalAlignment="Right"/>
                          </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Clips}" Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="#161616" BorderThickness="0,0,0,1" Padding="14,5" Background="Transparent">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="200"/>
                                  </Grid.ColumnDefinitions>
                                  <CheckBox Style="{StaticResource DarkCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Visibility="{Binding CanSelect, Converter={StaticResource Vis}}"/>
                                  <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE768;" Tag="{Binding PlayTag}" ToolTip="Play" HorizontalAlignment="Left"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{Binding NameColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Path}"/>
                                  <TextBlock Grid.Column="3" Text="{Binding Recorded}" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="4" Text="{Binding Size}" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                                  <Border Grid.Column="5" CornerRadius="9" Padding="9,2" Background="{Binding ChipBg}" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding StatusTip}">
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding ChipFg}"/>
                                  </Border>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </DockPanel>

        <!-- ======== ACTIVITY ======== -->
        <DockPanel x:Name="PageActivity" Visibility="Collapsed" Margin="24,0,24,16" MaxWidth="1340">
          <Grid DockPanel.Dock="Top" Margin="0,22,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontSize="15" Text="Activity" VerticalAlignment="Center"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="16,1,0,0" VerticalAlignment="Center" Text="Click a row to play the video"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="ActSummary" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <Button x:Name="ActClear" Style="{StaticResource BtnSmall}" Content="Clear log..."/>
            </StackPanel>
          </Grid>
          <Border DockPanel.Dock="Top" Background="#151515" Height="34">
            <Grid Margin="14,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="130"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource CardTitleText}" Text="TIME"/>
              <TextBlock Grid.Column="1" Style="{StaticResource CardTitleText}" Text="GAME"/>
              <TextBlock Grid.Column="2" Style="{StaticResource CardTitleText}" Text="FILE"/>
              <TextBlock Grid.Column="3" Style="{StaticResource CardTitleText}" Text="BEFORE"/>
              <TextBlock Grid.Column="4" Style="{StaticResource CardTitleText}" Text="AFTER"/>
              <TextBlock Grid.Column="5" Style="{StaticResource CardTitleText}" Text="SAVED"/>
              <TextBlock Grid.Column="6" Style="{StaticResource CardTitleText}" Text="RESULT"/>
            </Grid>
          </Border>
          <Border Background="#1C1C1C">
            <Grid>
              <TextBlock x:Name="ActEmpty" Margin="14" Foreground="{StaticResource Muted}" Text="Nothing has been compressed yet."/>
              <ItemsControl x:Name="ActList" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource RowBtn}" Tag="{Binding Path}" ToolTip="{Binding Tip}">
                    <Border BorderBrush="#151515" BorderThickness="0,0,0,1" Padding="14,9" Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="130"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Time}" Foreground="#9A9A9A"/>
                        <TextBlock Grid.Column="1" Text="{Binding Game}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding File}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Before}" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Column="4" Text="{Binding After}" Foreground="#B0B0B0"/>
                        <TextBlock Grid.Column="5" Text="{Binding Saved}" Foreground="#3FB950"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal">
                          <TextBlock x:Name="res" Text="{Binding ResultText}" Foreground="#D29922" VerticalAlignment="Center"/>
                          <Button Style="{StaticResource IconBtn}" Content="&#xE890;" Tag="{Binding CompareTag}" ToolTip="Compare before / after" Margin="6,-4,0,-4"
                                  Visibility="{Binding HasCompare, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Margin="0,6,0,0" Visibility="{Binding HasProblem, Converter={StaticResource Vis}}">
                          <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="{Binding FixText}" Tag="{Binding FixTag}" Padding="10,3"
                                  Margin="12,0,0,0" VerticalAlignment="Top" Visibility="{Binding HasFix, Converter={StaticResource Vis}}"/>
                          <TextBlock Text="{Binding Problem}" Foreground="#D9B36A" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                      </Grid>
                    </Border>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Result}" Value="OK"><Setter TargetName="res" Property="Foreground" Value="#3FB950"/></DataTrigger>
                      <DataTrigger Binding="{Binding Result}" Value="OK-MOVED"><Setter TargetName="res" Property="Foreground" Value="#3FB950"/></DataTrigger>
                      <DataTrigger Binding="{Binding Result}" Value="TEST-OK"><Setter TargetName="res" Property="Foreground" Value="#58A6FF"/></DataTrigger>
                      <DataTrigger Binding="{Binding Result}" Value="FAILED"><Setter TargetName="res" Property="Foreground" Value="#F85149"/></DataTrigger>
                      <DataTrigger Binding="{Binding Result}" Value="SKIPPED"><Setter TargetName="res" Property="Foreground" Value="#9A9A9A"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </DockPanel>

        <!-- ======== SETTINGS ======== -->
        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="24,4,24,24" MaxWidth="1340">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="16" Foreground="#BDBDBD" Margin="4,24,10,12"/>
                <TextBlock Style="{StaticResource Section}" Margin="0,22,0,12" Text="Compression"/>
              </StackPanel>
              <Border Background="#1D1D1D" Padding="14,12,14,14" BorderBrush="#131313" BorderThickness="0,0,0,1">
                <StackPanel>
                  <TextBlock FontSize="12.5" Text="What happens to your original recordings"/>
                  <TextBlock Style="{StaticResource Label}" Margin="0,3,0,12" TextWrapping="Wrap"
                             Text="Important: this decides whether originals are kept, deleted or moved after compressing."/>
                  <UniformGrid Columns="3">
                    <RadioButton x:Name="ModeTest" GroupName="mode" Style="{StaticResource ModeTile}" Margin="0,0,5,0">
                      <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="22" Foreground="#58A6FF"/>
                        <TextBlock Text="Test" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" FontSize="11.5"
                                   Text="Originals are kept. A few compressed copies go to the test folder so you can compare."/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeReplace" GroupName="mode" Style="{StaticResource ModeTile}" Margin="5,0">
                      <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="22" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Replace" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" FontSize="11.5"
                                   Text="The compressed file takes its place. The original is deleted after it's checked. Saves the most space."/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeMove" GroupName="mode" Style="{StaticResource ModeTile}" Margin="5,0,0,0">
                      <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DE;" FontSize="22" Foreground="#D29922"/>
                        <TextBlock Text="Move" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" FontSize="11.5"
                                   Text="The compressed file takes its place. The original moves to the &quot;Move originals to&quot; folder."/>
                      </StackPanel>
                    </RadioButton>
                  </UniformGrid>
                  <StackPanel x:Name="RecycleRow" Orientation="Horizontal" Margin="2,14,0,0">
                    <CheckBox x:Name="SetRecycle" Style="{StaticResource DarkCheck}" Content="Replace: send originals to the Recycle Bin instead of deleting them"/>
                    <Button x:Name="InfoRecycle" Style="{StaticResource InfoBtn}" Margin="10,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RowLabel}" Margin="14,0,8,0" Text="Video bitrate"/>
                    <Button x:Name="InfoRate" Style="{StaticResource InfoBtn}"/></StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <DockPanel>
                      <TextBlock x:Name="SetRateText" DockPanel.Dock="Right" Width="132" Margin="14,0,0,0" Style="{StaticResource RowState}" Text="20 Mbps"/>
                      <Slider x:Name="SetRate" Style="{StaticResource DarkSlider}" Minimum="8" Maximum="40" TickFrequency="1" SmallChange="1" LargeChange="2" Value="20"/>
                    </DockPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RowLabel}" Margin="14,0,8,0" Text="Encoder preset"/>
                    <Button x:Name="InfoPreset" Style="{StaticResource InfoBtn}"/></StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <ComboBox x:Name="SetPreset" Style="{StaticResource DarkCombo}">
                      <ComboBoxItem Content="Speed"/>
                      <ComboBoxItem Content="Balanced (recommended)"/>
                      <ComboBoxItem Content="Quality - less than half the speed"/>
                    </ComboBox>
                  </Border>
                </Grid>
              </Border>

              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE823;" FontSize="16" Foreground="#BDBDBD" Margin="4,24,10,12"/>
                <TextBlock Style="{StaticResource Section}" Margin="0,22,0,12" Text="Automation"/>
              </StackPanel>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RowLabel}" Margin="14,0,8,0" Text="Automatic compression"/>
                    <Button x:Name="InfoAuto2" Style="{StaticResource InfoBtn}"/></StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock x:Name="SetAutoText" Style="{StaticResource RowState}" Text="Disabled"/>
                      <ToggleButton x:Name="SetAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Start after being idle for"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <ComboBox x:Name="SetIdle" Style="{StaticResource DarkCombo}"/>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Start with Windows"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock x:Name="SetBootText" Style="{StaticResource RowState}" Text="Disabled"/>
                      <ToggleButton x:Name="SetBoot" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="16" Foreground="#BDBDBD" Margin="4,24,10,12"/>
                <TextBlock Style="{StaticResource Section}" Margin="0,22,0,12" Text="Folders"/>
              </StackPanel>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Recordings"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <DockPanel><Button x:Name="SetRecBrowse" DockPanel.Dock="Right" Style="{StaticResource WinBtn}" Width="30" Content="&#xE8DA;" FontSize="13"/>
                      <TextBox x:Name="SetRec"/></DockPanel>
                  </Border>
                </Grid>
              </Border>
              <Border x:Name="AdrHint" Background="#1D1D1D" Padding="14,8" Visibility="Collapsed" BorderBrush="#131313" BorderThickness="0,0,0,1">
                <DockPanel>
                  <Button x:Name="AdrUse" DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Use that folder" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <TextBlock x:Name="AdrText" FontSize="12" Foreground="#D29922" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Test copies"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <DockPanel><Button x:Name="SetTestBrowse" DockPanel.Dock="Right" Style="{StaticResource WinBtn}" Width="30" Content="&#xE8DA;" FontSize="13"/>
                      <TextBox x:Name="SetTest"/></DockPanel>
                  </Border>
                </Grid>
              </Border>
              <Border x:Name="RowMove" Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="RowMoveLabel" Style="{StaticResource RowLabel}" Text="Move originals to"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <DockPanel><Button x:Name="SetMoveBrowse" DockPanel.Dock="Right" Style="{StaticResource WinBtn}" Width="30" Content="&#xE8DA;" FontSize="13"/>
                      <TextBox x:Name="SetMove"/></DockPanel>
                  </Border>
                </Grid>
              </Border>
              <TextBlock x:Name="RowMoveHint" Visibility="Collapsed" Margin="4,6,0,0" FontSize="11.5" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                         Text="Move mode is on: every original recording ends up in this folder. Make sure it's on a drive with enough space."/>

              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="16" Foreground="#BDBDBD" Margin="4,24,10,12"/>
                <TextBlock Style="{StaticResource Section}" Margin="0,22,0,12" Text="App"/>
              </StackPanel>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Open videos with"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <ComboBox x:Name="SetPlayer" Style="{StaticResource DarkCombo}"/>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Log file"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock Style="{StaticResource RowState}" Text="compress-log.csv"/>
                      <Button x:Name="SetOpenLog" Style="{StaticResource BtnSmall}" Content="Open" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Program folder"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock x:Name="SetAppDir" Style="{StaticResource RowState}" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                      <Button x:Name="SetOpenApp" Style="{StaticResource BtnSmall}" Content="Open" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Uninstall"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock Style="{StaticResource RowState}" Text="Recordings are never touched"/>
                      <Button x:Name="SetUninstall" Style="{StaticResource BtnDanger}" Content="Uninstall..." HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Welcome guide"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock Style="{StaticResource RowState}" Text="The 3-step setup from the first start"/>
                      <Button x:Name="SetWelcome" Style="{StaticResource BtnSmall}" Content="Run again" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                  </Border>
                </Grid>
              </Border>

              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="16" Foreground="#BDBDBD" Margin="4,24,10,12"/>
                <TextBlock Style="{StaticResource Section}" Margin="0,22,0,12" Text="About &amp; updates"/>
              </StackPanel>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Version"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock x:Name="SetVersion" Style="{StaticResource RowState}" Text="ReLive Compressor" Margin="0,0,110,0" TextTrimming="CharacterEllipsis"/>
                      <Button x:Name="SetCheckUpd" Style="{StaticResource BtnSmall}" Content="Check now" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource Row}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowLabel}" Text="Check for updates"/>
                  <Border Grid.Column="1" Style="{StaticResource RowValue}">
                    <Grid><TextBlock x:Name="SetUpdAutoText" Style="{StaticResource RowState}" Text="Automatically, once a day"/>
                      <ToggleButton x:Name="SetUpdAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
